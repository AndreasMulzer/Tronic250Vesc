    {
        "id": "3b7c8cf2632cafb3",
        "type": "function",
        "z": "e3e367227d20fc75",
        "name": "initialize flow.vesc + UI",
        "func": "const DEFAULT={config:{engineOn:false,recuperate:{active:false,current:10},handbrake:{current:10}},status:{driveMode:\"unknown\",available:false,lastRxMs:0,erpm:0,recuperateAutoAllowed:false,recuperateEffective:false,recuperateReason:\"not evaluated\",batterySoc:null,batteryAgeMs:null},telemetry:{},memory:{}};\nfunction obj(v){return v&&typeof v===\"object\"&&!Array.isArray(v)}\nfunction merge(dst,src){for(const k of Object.keys(src)){if(obj(src[k])){if(!obj(dst[k]))dst[k]={};merge(dst[k],src[k])}else if(dst[k]===undefined)dst[k]=src[k]}return dst}\nlet v=flow.get(\"vesc\",\"memory\");if(!obj(v))v={};merge(v,DEFAULT);\nconst old=flow.get(\"vesc\",\"file\");if(obj(old?.config)){let c=old.config;if(typeof c.engineOn===\"boolean\")v.config.engineOn=c.engineOn;if(typeof c.recuperate?.active===\"boolean\")v.config.recuperate.active=c.recuperate.active;for(const [target,source] of [[v.config.recuperate,c.recuperate],[v.config.handbrake,c.handbrake]]){let n=Number(source?.current);if(Number.isFinite(n)&&n>=0&&n<=100)target.current=n}}\nflow.set(\"vesc\",v,\"memory\");flow.set(\"vesc\",{config:v.config},\"file\");return [{topic:\"engine_on\",payload:v.config.engineOn},{topic:\"vesc_recuperate\",payload:v.config.recuperate.active},{topic:\"vesc_brake_current\",payload:v.config.recuperate.current},{topic:\"vesc_handbrake_current\",payload:v.config.handbrake.current}];",
