    {
        "id": "3d6d755ef82aefb8",
        "type": "function",
        "z": "e3e367227d20fc75",
        "name": "build commands (LispBM)",
        "func": "// Motor-Sollwert: -100..+100 Prozent -> LispBM int16 -1000..+1000.\n// LispBM auf dem Tronic setzt daraus +/-75000 ERPM um.\n// STOP = 0 Prozent; aktive Bremse/Reku per CAN wird bewusst NICHT behauptet.\nconst p=Number(msg.payload);\nif(!Number.isFinite(p)||p<-100||p>100){node.error(\"Sliderwert außerhalb -100..100%\",msg);return null;}\nmsg.payload={cmd:\"lisp_percent\",percent:p};\nnode.status({fill:p===0?\"grey\":\"green\",shape:\"dot\",text:`LispBM ${p.toFixed(1)} %`});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 180,
        "wires": [
            [
                "68e1f123023253f2"
            ]
        ]
    },
    {
        "id": "68e1f123023253f2",
        "type": "function",
        "z": "e3e367227d20fc75",
        "name": "VESC CAN Command Builder – LispBM",
        "func": "// VESC 6.02: COMM_FORWARD_CAN(34), CAN-ID 29,\n// COMM_CUSTOM_APP_DATA(36), payload [1, signed int16 big-endian].\nconst CAN=29;\nfunction crc16(b){let c=0;for(const x of b){c^=x<<8;for(let i=0;i<8;i++)c=(c&0x8000)?((c<<1)^0x1021)&65535:(c<<1)&65535;}return c;}\nconst x=msg.payload||{};\nif(x.cmd!==\"lisp_percent\"||!Number.isFinite(x.percent)){node.error(\"Ungültiger LispBM Sollwert\",msg);return null;}\nconst value=Math.round(Math.max(-100,Math.min(100,x.percent))*10);\nconst p=Buffer.alloc(6);p[0]=34;p[1]=CAN;p[2]=36;p[3]=1;p.writeInt16BE(value,4);\nconst crc=crc16(p);\nmsg.payload=Buffer.from([2,p.length,...p,crc>>8,crc&255,3]);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
