    {
        "id": "e2c96b25e47d8bd0",
        "type": "function",
        "z": "e3e367227d20fc75",
        "name": "VESC -> SignalK full then changes",
        "func": "const p=msg.payload||{},now=new Date().toISOString(),ERPM_FACTOR=7,GEAR_RATIO=14;\nfunction num(v){return typeof v===\"number\"&&Number.isFinite(v)}function obj(v){return v&&typeof v===\"object\"&&!Array.isArray(v)}let v=flow.get(\"vesc\",\"memory\")||{};v.status??={};v.memory??={};function setMemory(path,value){const parts=path.split(\".\");let o=v.memory;for(let i=0;i<parts.length-1;i++){if(!obj(o[parts[i]]))o[parts[i]]={};o=o[parts[i]];}o[parts.at(-1)]=value;}\nfunction faultText(code){const names=[\"none\",\"over_voltage\",\"under_voltage\",\"drv\",\"abs_over_current\",\"over_temp_fet\",\"over_temp_motor\",\"gate_driver_over_voltage\",\"gate_driver_under_voltage\",\"mcu_under_voltage\",\"watchdog_reset\",\"encoder_spi\",\"encoder_sincos_below_min_amplitude\",\"encoder_sincos_above_max_amplitude\",\"flash_corruption\",\"high_offset_current_sensor_1\",\"high_offset_current_sensor_2\",\"high_offset_current_sensor_3\",\"unbalanced_currents\",\"resolver_lot\",\"resolver_dos\",\"resolver_los\"];return names[Number(code)]||`unknown_${code}`;}\nfunction motorState(){if(num(p.mc_fault_code)&&p.mc_fault_code!==0)return \"fault\";const mode=v.status.driveMode,erpm=Number(p.rpm),input=Number(p.avg_input_current);if(mode===\"freewheel\")return \"stopped\";if(mode===\"generate\"||input<-0.5)return Math.abs(erpm)>1500?\"generative\":\"stopped generative\";if(mode===\"handbrake\")return Math.abs(erpm)>1500?\"handbrake\":\"stopped handbrake\";if(Math.abs(erpm)>1500)return erpm>0?\"forward\":\"reverse\";return \"stopped\";}\nconst values=[],meta=[];function add(path,value){if(value===undefined||value===null||(typeof value===\"number\"&&!Number.isFinite(value)))return;values.push({path,value});setMemory(path,value);}function addMeta(path,displayName,units){const value={displayName};if(units)value.units=units;meta.push({path,value});}\nconst only=typeof p.available===\"boolean\"&&!num(p.rpm)&&!num(p.v_in);const available=typeof p.available===\"boolean\"?p.available:num(p.v_in);\nadd(\"propulsion.torqeedo.drive.label\",\"Torqeedo\");add(\"propulsion.torqeedo.drive.available\",available);add(\"propulsion.torqeedo.controller.available\",available);\nif(!only){add(\"propulsion.torqeedo.drive.state\",motorState());add(\"propulsion.torqeedo.drive.type\",\"pod\");add(\"propulsion.torqeedo.drive.fuel.type\",\"electric\");add(\"propulsion.torqeedo.drive.transmission.gearRatioText\",\"14:1\");if(v.status.driveMode)add(\"propulsion.torqeedo.controller.driveMode\",v.status.driveMode);}\nif(num(p.rpm)){add(\"propulsion.torqeedo.drive.revolutions\",p.rpm/ERPM_FACTOR/GEAR_RATIO/60);add(\"propulsion.torqeedo.drive.motorRpm\",p.rpm/ERPM_FACTOR);add(\"propulsion.torqeedo.drive.propellerRpm\",p.rpm/ERPM_FACTOR/GEAR_RATIO);}\nif(num(p.temp_motor))add(\"propulsion.torqeedo.drive.temperature\",p.temp_motor+273.15);if(num(p.temp_fet))add(\"propulsion.torqeedo.controller.temperature\",p.temp_fet+273.15);if(num(p.avg_motor_current))add(\"propulsion.torqeedo.controller.current\",p.avg_motor_current);if(num(p.avg_input_current))add(\"propulsion.torqeedo.controller.inputCurrent\",p.avg_input_current);if(num(p.duty_cycle_now))add(\"propulsion.torqeedo.controller.dutyCycle\",p.duty_cycle_now);if(num(p.v_in))add(\"propulsion.torqeedo.controller.inputVoltage\",p.v_in);if(num(p.v_in)&&num(p.avg_input_current)){const power=p.v_in*p.avg_input_current;add(\"propulsion.torqeedo.drive.power\",power);add(\"propulsion.torqeedo.controller.inputPower\",power);}if(num(p.mc_fault_code)){add(\"propulsion.torqeedo.controller.faultCode\",faultText(p.mc_fault_code));add(\"propulsion.torqeedo.controller.faultCodeNumber\",p.mc_fault_code);}\nfor(const [path,name,unit] of [[\"propulsion.torqeedo.drive.available\",\"Propulsion Available\"],[\"propulsion.torqeedo.drive.state\",\"Propulsion State\"],[\"propulsion.torqeedo.drive.revolutions\",\"Propeller Revolutions\",\"Hz\"],[\"propulsion.torqeedo.drive.motorRpm\",\"Motor RPM\",\"rpm\"],[\"propulsion.torqeedo.drive.propellerRpm\",\"Propeller RPM\",\"rpm\"],[\"propulsion.torqeedo.drive.temperature\",\"Motor Temperature\",\"K\"],[\"propulsion.torqeedo.drive.power\",\"Propulsion Power\",\"W\"],[\"propulsion.torqeedo.controller.temperature\",\"Controller Temperature\",\"K\"],[\"propulsion.torqeedo.controller.current\",\"Motor Current\",\"A\"],[\"propulsion.torqeedo.controller.inputCurrent\",\"Input Current\",\"A\"],[\"propulsion.torqeedo.controller.inputPower\",\"Input Power\",\"W\"],[\"propulsion.torqeedo.controller.inputVoltage\",\"Input Voltage\",\"V\"],[\"propulsion.torqeedo.controller.dutyCycle\",\"Duty Cycle\",\"ratio\"],[\"propulsion.torqeedo.controller.faultCode\",\"Fault Code\"]])addMeta(path,name,unit);\nconst wasFull=context.get(\"fullSent\")===true,previous=context.get(\"lastSent\")||{},changed=[];for(const item of values){const s=JSON.stringify(item.value);if(!wasFull||previous[item.path]!==s){changed.push(item);previous[item.path]=s;}}flow.set(\"vesc\",v,\"memory\");if(!changed.length&&wasFull)return null;context.set(\"lastSent\",previous);context.set(\"fullSent\",true);msg.payload={context:\"vessels.self\",updates:[{source:{label:\"vesc\",type:\"VESC\"},timestamp:now,values:changed},...(!wasFull?[{source:{label:\"vesc\",type:\"VESC\"},timestamp:now,meta}]:[])]};return msg;",
