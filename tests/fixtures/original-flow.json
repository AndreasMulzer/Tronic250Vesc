    {
        "id": "d7c31336a667e50b",
        "type": "function",
        "z": "e3e367227d20fc75",
        "name": "VESC CAN Packet Parser",
        "func": "const GET=4,FWD=34;let rx=context.get(\"rx\")||Buffer.alloc(0),last=context.get(\"last\")||0;\nif(msg.topic===\"watchdog\")return {payload:{available:Date.now()-last<=2000,timestamp:Date.now()}};\nif(!Buffer.isBuffer(msg.payload))msg.payload=Buffer.from(msg.payload);rx=Buffer.concat([rx,msg.payload]);\nfunction crc(b){let c=0;for(const x of b){c^=x<<8;for(let i=0;i<8;i++)c=(c&0x8000)?((c<<1)^0x1021)&65535:(c<<1)&65535;}return c;}\nfunction parse(p){if(p[0]===FWD)return parse(p.slice(2));if(p[0]!==GET)return {available:true};let i=1,v;const h=n=>p.length>=i+n,q=s=>h(2)?(v=p.readInt16BE(i),i+=2,v/s):null,w=s=>h(4)?(v=p.readInt32BE(i),i+=4,v/s):null,z=()=>h(1)?(v=p.readInt8(i),i++,v):null;return {available:true,temp_fet:q(10),temp_motor:q(10),avg_motor_current:w(100),avg_input_current:w(100),avg_id:w(100),avg_iq:w(100),duty_cycle_now:q(1000),rpm:w(1),v_in:q(10),amp_hours:w(10000),amp_hours_charged:w(10000),watt_hours:w(10000),watt_hours_charged:w(10000),tachometer:w(1),tachometer_abs:w(1),mc_fault_code:z(),timestamp:Date.now()};}\nconst out=[];while(rx.length>=5){let s=rx.indexOf(2);if(s<0){rx=Buffer.alloc(0);break;}if(s>0)rx=rx.slice(s);const l=rx[1],t=l+5;if(rx.length<t)break;const p=rx.slice(2,l+2),ok=rx[t-1]===3&&crc(p)===(rx[t-3]<<8|rx[t-2]);if(ok){last=Date.now();context.set(\"last\",last);out.push({payload:parse(p)});}rx=rx.slice(t);}context.set(\"rx\",rx);return out.length?[out]:null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1250,
        "y": 240,
        "wires": [
            [
                "0eb4966efd4f66ca",
                "02d1f8b09bbb8a26"
            ]
        ]
    },
    {
        "id": "0eb4966efd4f66ca",
        "type": "function",
        "z": "e3e367227d20fc75",
        "name": "store VESC status in flow.vesc",
        "func": "function obj(v){return v&&typeof v===\"object\"&&!Array.isArray(v)}function has(o,k){return Object.prototype.hasOwnProperty.call(o,k)}function telemetry(p){return [\"rpm\",\"temp_fet\",\"temp_motor\",\"v_in\",\"avg_motor_current\",\"avg_input_current\",\"duty_cycle_now\",\"mc_fault_code\"].some(k=>has(p,k));}\nconst p=msg.payload||{};let v=flow.get(\"vesc\",\"memory\");if(!obj(v))v={};v.config??={};v.status??={};v.telemetry??={};v.memory??={};if(typeof p.available===\"boolean\")v.status.available=p.available;if(telemetry(p)){for(const [k,val] of Object.entries(p))if(val!==null&&val!==undefined)v.telemetry[k]=val;v.status.lastRxMs=Date.now();if(Number.isFinite(Number(p.rpm)))v.status.erpm=Number(p.rpm);}flow.set(\"vesc\",v,\"memory\");return msg;",
